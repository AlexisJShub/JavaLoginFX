<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="950.0"
            styleClass="fondo-registro"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.js.controller.RegistroController">

    <stylesheets>
        <URL value="@/org/js/view/style/registrovista.css"/>
    </stylesheets>

    <children>

        <VBox alignment="TOP_CENTER"
              layoutX="255.0"
              layoutY="14.0"
              prefWidth="440.0"
              spacing="9.0"
              styleClass="tarjeta-registro">

            <children>

                <Label text="JAVALOGIN"
                       styleClass="logo-registro"/>

                <Label text="Crear cuenta nueva"
                       styleClass="titulo-registro"/>

                <Label text="Elige tu rol de trabajo para personalizar tu acceso"
                       wrapText="true"
                       prefWidth="360.0"
                       styleClass="subtitulo-registro"/>

                <HBox alignment="CENTER"
                      spacing="10.0"
                      styleClass="fila-chips">

                    <children>

                        <ToggleButton fx:id="btnRolAdmin"
                                      text="Administrador"
                                      prefWidth="130.0"
                                      styleClass="chip-rol"/>

                        <ToggleButton fx:id="btnRolEmpleado"
                                      text="Empleado"
                                      prefWidth="115.0"
                                      styleClass="chip-rol"/>

                        <ToggleButton fx:id="btnRolCajero"
                                      text="Cajero"
                                      prefWidth="100.0"
                                      styleClass="chip-rol"/>

                    </children>
                </HBox>

                <Label text="Usuario"
                       styleClass="etiqueta-registro"/>

                <TextField fx:id="txtNuevoUsuario"
                           promptText="Elige un nombre de usuario"
                           prefHeight="40.0"
                           prefWidth="360.0"
                           styleClass="campo-registro"/>

                <Label text="Contraseña"
                       styleClass="etiqueta-registro"/>

                <PasswordField fx:id="txtNuevaPassword"
                               promptText="Crea una contraseña"
                               prefHeight="40.0"
                               prefWidth="360.0"
                               styleClass="campo-registro"/>

                <Label text="Confirmar contraseña"
                       styleClass="etiqueta-registro"/>

                <PasswordField fx:id="txtConfirmarPassword"
                               promptText="Repite la contraseña"
                               prefHeight="40.0"
                               prefWidth="360.0"
                               styleClass="campo-registro"
                               onAction="#eventoRegistrarCuenta"/>

                <Label fx:id="lblMensajeRegistro"
                       text=""
                       wrapText="true"
                       prefWidth="360.0"
                       styleClass="mensaje-registro"/>

                <Button text="Crear cuenta"
                        onAction="#eventoRegistrarCuenta"
                        prefHeight="46.0"
                        prefWidth="360.0"
                        defaultButton="true"
                        styleClass="boton-crear-cuenta"/>

                <Hyperlink fx:id="lnkVolverLogin"
                           text="¿Ya tienes cuenta? Inicia sesión"
                           onAction="#eventoVolverLogin"
                           styleClass="enlace-volver"/>

            </children>
        </VBox>

    </children>
</AnchorPane>

